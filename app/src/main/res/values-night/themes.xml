<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.Nightlearn" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">#D9D9D9</item>
        <item name="colorPrimaryVariant">#D9D9D9</item>
        <item name="colorOnPrimary">#585858</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#0000EE</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:windowBackground">@drawable/ic_background</item>
        <item name="android:textColor">#585858</item>

        <item name="android:editTextColor">#585858</item>
        <item name="android:colorControlNormal">#585858</item>

        <!-- <item name="android:buttonCornerRadius">30dp</item> -->

        <!-- Customize your theme here. -->
    </style>

    <style name="BottomNavigationTextStyle">
        <item name="android:textSize">16dp</item>

    </style>

    <style name="DialogAnimation">
        <item name="android:windowExitAnimation">@anim/dialog_slide_out_animation</item>
        <item name="android:windowEnterAnimation">@anim/dialog_slide_in_animation</item>
        <item name="android:layout_marginHorizontal">0dp</item>
    </style>

</resources>