<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.game.GameMatchCardsFragment">


    <LinearLayout
        android:id="@+id/llMatchCardsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_top"
        android:gravity="center"
        android:paddingVertical="25dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMatchCardsRound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Round 1"
            android:textSize="20dp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvMatchCardsSubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Choose right definition!"
        android:textSize="30dp"
        android:textColor="@color/brightGray"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout2"
        app:layout_constraintTop_toBottomOf="@+id/llMatchCardsTitle" />

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="300dp"
        android:layout_height="200dp"
        android:background="@drawable/flashcard_background"
        app:layout_constraintBottom_toTopOf="@+id/llMatchCardsButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llMatchCardsTitle">

        <TextView
            android:id="@+id/tvMatchCardsQuestionExplanation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="10dp"
            android:text="Some kind of explanation randomly taken from the learnset"
            android:textSize="20dp" />


    </LinearLayout>


    <LinearLayout
        android:id="@+id/llMatchCardsButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/llMatchCardsButtonsLevelButtons"
        android:layout_marginBottom="5dp">

        <TextView
            android:id="@+id/tvMatchCardsTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="15 sec"
            android:gravity="center"
            android:textSize="22dp"
            android:textColor="@color/brightGray"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/darkGray"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                    <TextView
                        android:id="@+id/btnMatchCardsAnswer1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="30dp"
                        android:paddingVertical="20dp"
                        android:textSize="20dp"
                        android:text="Answer 1"
                        android:textColor="@color/alert_dialog_textcolor_focused"
                        android:background="@drawable/btn_background"/>


            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnMatchCardsAnswer2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="20dp"
                    android:textSize="20dp"
                    android:background="@drawable/btn_background"
                    android:textColor="@color/alert_dialog_textcolor_focused"
                    android:text="Answer 2"/>

            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="10dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnMatchCardsAnswer3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_background"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="20dp"
                    android:textColor="@color/alert_dialog_textcolor_focused"
                    android:text="Answer 3"
                    android:textSize="20dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnMatchCardsAnswer4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="30dp"
                    android:paddingVertical="20dp"
                    android:textSize="20dp"
                    android:textColor="@color/alert_dialog_textcolor_focused"
                    android:background="@drawable/btn_background"
                    android:text="Answer 4"/>

            </LinearLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/darkGray"
            android:layout_marginBottom="5dp"/>

    </LinearLayout>




    <LinearLayout
        android:id="@+id/llMatchCardsButtonsLevelButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="15dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/llMatchCardsBtnPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_background">

                <TextView
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/flashcard_transparent_ripple_background"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="5dp"
                    android:text="Pause game"
                    android:textColor="@color/darkGray"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/llMatchCardsBtnSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_background">

                <TextView
                    android:id="@+id/tvMatchCardsBtnSkip"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/flashcard_transparent_ripple_background"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="Skip this round"
                    android:textColor="@color/darkGray"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
