<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.game.GameMatchCardsFragment">


    <LinearLayout
        android:id="@+id/llMatchCardsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/background_top"
        android:gravity="center"
        android:paddingVertical="25dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvMatchCardsRound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Round 1"
            android:textSize="20dp"
            android:textStyle="bold" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvMatchCardsSubTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Choose right definition!"
        android:textSize="30dp"
        android:textColor="@color/brightGray"
        app:layout_constraintBottom_toTopOf="@+id/llMatchCardsQuestionCard"
        app:layout_constraintTop_toBottomOf="@+id/llMatchCardsTitle" />

    <LinearLayout
        android:id="@+id/llMatchCardsQuestionCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/flashcard_background"
        android:gravity="center_horizontal"
        android:minWidth="250dp"
        android:orientation="vertical"
        android:paddingHorizontal="15dp"
        app:layout_constraintBottom_toTopOf="@+id/llMatchCardsButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llMatchCardsTitle"
        app:layout_constraintVertical_bias="0.664">

        <TextView
            android:id="@+id/tvMatchCardsQuestionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Explanation/Definition:"
            android:textSize="18sp"
            android:textStyle="italic|bold" />

        <TextView
            android:id="@+id/tvMatchCardsQuestionCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:gravity="center"
            android:maxWidth="300dp"
            android:text="Some kind of question randomly taken from the learnset"
            android:textSize="20dp" />


    </LinearLayout>

    <LinearLayout
        android:id="@+id/llMatchCardsButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/llMatchCardsLevelButtons"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMatchCardsTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="15 sec"
                android:gravity="center"
                android:textSize="22dp"
                android:textColor="@color/brightGray"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="@color/darkGray"
                android:layout_marginBottom="5dp"/>

        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnMatchCardsAnswer1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp"
                    android:textSize="20sp"
                    android:text="Answer 1"
                    android:gravity="center"
                    android:layout_marginVertical="5dp"
                    android:textColor="@color/dark_gray_focused"
                    android:background="@drawable/btn_background" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnMatchCardsAnswer2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:layout_marginVertical="5dp"
                    android:background="@drawable/btn_background"
                    android:textColor="@color/dark_gray_focused"
                    android:text="Answer 2" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnMatchCardsAnswer3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/btn_background"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp"
                    android:gravity="center"
                    android:textColor="@color/dark_gray_focused"
                    android:text="Answer 3"
                    android:textSize="20sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="fill"
                android:layout_columnWeight="1"
                android:layout_rowWeight="1"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnMatchCardsAnswer4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="20dp"
                    android:paddingVertical="20dp"
                    android:textSize="20sp"
                    android:gravity="center"
                    android:textColor="@color/dark_gray_focused"
                    android:background="@drawable/btn_background"
                    android:text="Answer 4" />

            </LinearLayout>

        </GridLayout>


        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/darkGray"
            android:layout_marginVertical="5dp"/>

    </LinearLayout>



    <LinearLayout
        android:id="@+id/llMatchCardsLevelButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="15dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/llMatchCardsBtnPause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_background">

                <TextView
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/flashcard_transparent_ripple_background"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:paddingHorizontal="5dp"
                    android:text="Pause game"
                    android:textColor="@color/darkGray"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/llMatchCardsBtnSkip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_background">

                <TextView
                    android:id="@+id/tvMatchCardsBtnSkip"
                    android:layout_width="150dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/flashcard_transparent_ripple_background"
                    android:gravity="center"
                    android:paddingVertical="10dp"
                    android:text="Skip this round"
                    android:textColor="@color/darkGray"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
